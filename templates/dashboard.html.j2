<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ d.meta.titel }} {{ d.meta.plz }} — {{ d.meta.datum_kurz }}</title>
<style>
:root{
  --bg:#0d1117; --card:#161b22; --card2:#1c2430; --line:#2c3644;
  --tx:#e8eef6; --tx2:#9aa8b8; --tx3:#6b7a8c;
  --rot:#ef4444; --orange:#f59e0b; --gruen:#22c55e; --blau:#3b82f6; --lila:#a78bfa;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);
  font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  -webkit-text-size-adjust:100%}
.wrap{max-width:820px;margin:0 auto;padding:14px 14px 40px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:16px;margin-bottom:14px}
h2{font-size:13px;letter-spacing:.09em;text-transform:uppercase;color:var(--tx3);
  margin:0 0 12px;font-weight:600}
h3{font-size:13px;color:var(--tx2);margin:18px 0 8px;font-weight:600}
.mono{font-variant-numeric:tabular-nums}

.ampel{background:linear-gradient(160deg,#3b1113,#1b0c0e);border:1px solid #6b2226;
  border-radius:16px;padding:20px 18px;margin-bottom:14px}
.ampel .datum{font-size:13px;color:#e2a2a2;letter-spacing:.04em}
.ampel .verdikt{font-size:38px;line-height:1.05;font-weight:800;margin:8px 0 2px;color:#ff6b6b;
  letter-spacing:-.02em}
.ampel .preis{font-size:30px;font-weight:700;margin-top:10px;letter-spacing:-.02em}
.ampel .preis small{font-size:15px;font-weight:500;color:#e2a2a2}
.ampel .sub{font-size:14px;color:#f0bcbc;margin-top:6px}

.kacheln{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.kachel{background:var(--card2);border:1px solid var(--line);border-radius:11px;padding:12px}
.kachel .lbl{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--tx3)}
.kachel .val{font-size:24px;font-weight:700;margin-top:5px;letter-spacing:-.02em}
.kachel .val small{font-size:13px;font-weight:500;color:var(--tx2)}
.kachel .note{font-size:12px;color:var(--tx3);margin-top:3px}

table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.06em;
  color:var(--tx3);font-weight:600;padding:0 0 8px;border-bottom:1px solid var(--line)}
td{padding:9px 14px 9px 0;border-bottom:1px solid #202836;vertical-align:top}
td:last-child{padding-right:0}
tr:last-child td{border-bottom:none}
td.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.tw{color:var(--rot)}.tg{color:var(--gruen)}.tn{color:var(--tx2)}
table.tbl-markt{table-layout:fixed}
table.tbl-markt th:nth-child(1),table.tbl-markt td:nth-child(1){width:24%}
table.tbl-markt th:nth-child(2),table.tbl-markt td:nth-child(2){width:28%}
table.tbl-markt th:nth-child(3),table.tbl-markt td:nth-child(3){width:48%}
table.tbl-markt td.n{white-space:normal;word-break:break-word}
table.tbl-liefer{table-layout:fixed}
table.tbl-liefer th:nth-child(1),table.tbl-liefer td:nth-child(1){width:18%}
table.tbl-liefer th:nth-child(2),table.tbl-liefer td:nth-child(2){width:16%}
table.tbl-liefer th:nth-child(3),table.tbl-liefer td:nth-child(3){width:20%}
table.tbl-liefer th:nth-child(4),table.tbl-liefer td:nth-child(4){width:46%}
table.tbl-liefer td.n{white-space:normal;word-break:break-word}

ul.fakten{list-style:none;margin:0;padding:0;font-size:14px}
ul.fakten li{padding:7px 0 7px 16px;border-bottom:1px solid #202836;position:relative;color:var(--tx2)}
ul.fakten li:last-child{border-bottom:none}
ul.fakten li:before{content:"";position:absolute;left:0;top:15px;width:5px;height:5px;
  border-radius:50%;background:var(--tx3)}
ul.fakten b{color:var(--tx);font-weight:600}

.radar{display:flex;gap:11px;padding:11px 0;border-bottom:1px solid #202836;align-items:flex-start}
.radar:last-child{border-bottom:none}
.pfeil{font-size:19px;line-height:1.1;width:24px;flex:none;text-align:center}
.radar .txt{font-size:14px;color:var(--tx2);flex:1}
.radar .txt b{color:var(--tx);font-weight:600}
.horizont{font-size:11px;color:var(--tx3);text-transform:uppercase;letter-spacing:.06em;
  white-space:nowrap;padding-top:3px}

.termine{display:grid;grid-template-columns:1fr;gap:9px;margin-top:14px}
.termin{background:var(--card2);border:1px solid var(--line);border-left:3px solid var(--blau);
  border-radius:9px;padding:11px 13px}
.termin .t1{font-size:12px;color:var(--tx3);text-transform:uppercase;letter-spacing:.06em}
.termin .t2{font-size:16px;font-weight:700;margin-top:3px}
.termin .t3{font-size:13px;color:var(--tx2);margin-top:3px}
.termin.gruen{border-left-color:var(--gruen)}
.termin.orange{border-left-color:var(--orange)}

.limitbox{background:var(--card2);border:1px solid var(--line);border-radius:11px;
  padding:14px;margin-bottom:11px}
.limitbox .z{font-size:30px;font-weight:800;letter-spacing:-.02em}
.limitbox .z small{font-size:14px;font-weight:500;color:var(--tx2)}
.limitbox .d{font-size:13px;color:var(--tx2);margin-top:5px}

p.txt{font-size:14px;color:var(--tx2);margin:10px 0 0}
.warn{background:#2a1f08;border:1px solid #6b4e12;border-radius:10px;padding:11px 13px;
  font-size:13px;color:#f5d99a;margin-top:12px}
.info{background:#0f2030;border:1px solid #1d4260;border-radius:10px;padding:11px 13px;
  font-size:13px;color:#a8cbe6;margin-top:12px}

.fuss{display:grid;grid-template-columns:1fr;gap:16px;font-size:12px;color:var(--tx3);
  border-top:1px solid var(--line);padding-top:16px;margin-top:6px}
.fuss h4{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--tx2);
  margin:0 0 7px;font-weight:600}
.fuss div p{margin:0 0 5px;line-height:1.45}
svg{display:block;max-width:100%;height:auto}
@media(min-width:640px){
  .kacheln{grid-template-columns:repeat(4,1fr)}
  .termine{grid-template-columns:repeat(3,1fr)}
  .fuss{grid-template-columns:1fr 1fr}
}
details.expand{margin-top:10px}
details.expand>summary{cursor:pointer;list-style:none;font-size:12px;color:var(--tx3);
  text-transform:uppercase;letter-spacing:.06em;padding:6px 0;display:flex;align-items:center;gap:6px;
  user-select:none}
details.expand>summary::-webkit-details-marker{display:none}
details.expand>summary::before{content:"+";font-size:14px;color:var(--tx3);width:12px}
details.expand[open]>summary::before{content:"\2013"}
details.expand>summary:hover{color:var(--tx2)}
</style>
</head>
<body>
<div class="wrap">

<!-- 1 AMPEL -->
<div class="ampel">
  <div class="datum">{{ d.meta.titel }} · {{ d.meta.plz }} {{ d.meta.ort }} · {{ d.meta.datum }}</div>
  <div class="verdikt">{{ d.ampel.verdikt }}</div>
  <div class="preis mono">{{ d.ampel.preis_text }} <small>{{ d.ampel.einheit }}</small></div>
  <div class="sub">{{ d.ampel.kurzbegruendung }}</div>
  {% if d.ampel.ausfuehrliche_begruendung %}
  <details class="expand"><summary>Ausführliche Begründung</summary>
    <p class="txt" style="margin-top:8px">{{ d.ampel.ausfuehrliche_begruendung }}</p>
  </details>
  {% endif %}
</div>

<!-- 2 KACHELN -->
<div class="card">
  <h2>Auf einen Blick</h2>
  <div class="kacheln">
    {% for k in d.kacheln %}
    <div class="kachel">
      <div class="lbl">{{ k.label }}</div>
      <div class="val mono"{% if k.farbe %} style="color:var(--{{ k.farbe }})"{% endif %}>{{ k.wert }} <small>{{ k.einheit }}</small></div>
      <div class="note">{{ k.note }}</div>
    </div>
    {% endfor %}
  </div>
</div>

<!-- 3 PREIS -->
<div class="card">
  <h2>Preis und Perzentil</h2>
  {{ preisband_svg | safe }}
  <p class="txt">{{ d.preisband.vortag_html | safe }}</p>
  {% if d.preisband.warnung_html %}
  <div class="warn">{{ d.preisband.warnung_html | safe }}</div>
  {% endif %}
</div>

<!-- 4 MARKT -->
<div class="card">
  <h2>Markt</h2>
  <table class="tbl-markt">
    <tr><th>Größe</th><th class="n">Stand {{ d.markt.stand }}</th><th>Wirkung auf meinen Preis</th></tr>
    {% for z in d.markt.zeilen %}
    <tr><td>{{ z.groesse }}</td>
      <td class="n mono">{{ z.wert }}<br><span class="{{ z.aenderung_farbe|default('tn') }}">{{ z.aenderung }}</span></td>
      <td class="{{ z.wirkung_farbe|default('tn') }}">{{ z.wirkung }}</td></tr>
    {% endfor %}
  </table>
  {% if d.markt.einschaetzung_html %}
  <details class="expand"><summary>{{ d.markt.einschaetzung_titel|default("Markt-Einschätzung & Hintergrund") }}</summary>
    <div style="margin-top:8px">{{ d.markt.einschaetzung_html | safe }}</div>
  </details>
  {% endif %}
</div>

<!-- 5 TANK -->
<div class="card">
  <h2>Tank</h2>
  {{ tank_svg | safe }}
</div>

<!-- 6 SCHWELLEN / FROSTSPERRE / PROGNOSE -->
<div class="card">
  <h2>Schwellen, Frostsperre &amp; Füllstandsprognose</h2>
  {{ prognose_svg | safe }}
  <p class="txt">{{ d.prognose.kommentar }}</p>

  <div class="termine">
    {% for t in d.termine %}
    <div class="termin{% if t.farbe %} {{ t.farbe }}{% endif %}">
      <div class="t1">{{ t.titel }}</div><div class="t2">{{ t.wert }}</div>
      <div class="t3">{{ t.text }}</div>
    </div>
    {% endfor %}
  </div>

  {% if d.tank_details %}
  <details class="expand"><summary>Details ausklappen</summary>
    <ul class="fakten" style="margin-top:6px">
      {% for det in d.tank_details %}<li>{{ det | safe }}</li>{% endfor %}
    </ul>
  </details>
  {% endif %}
</div>

<!-- 7 LIEFERUNGEN -->
<div class="card">
  <h2>Lieferhistorie</h2>
  {% if d.lieferhistorie.hinweis %}
  <p class="note" style="color:var(--tx3);font-size:12px">{{ d.lieferhistorie.hinweis }}</p>
  {% endif %}
  <details class="expand"><summary>Alle Bestellungen im Detail</summary>
    <div style="margin-top:6px">
      <table class="tbl-liefer">
        <tr><th>Datum</th><th class="n">Menge</th><th class="n">Verbrauch bis dahin</th><th>Timing</th></tr>
        {% for l in d.lieferhistorie.zeilen %}
        <tr><td class="mono">{{ l.datum }}</td><td class="n mono">{{ l.menge }}</td>
          <td class="n mono">{{ l.verbrauch }}</td>
          <td class="{{ l.timing_farbe|default('tn') }}">{{ l.timing }}</td></tr>
        {% endfor %}
      </table>
      {% if d.lieferhistorie.lehre_html %}
      <div class="warn">{{ d.lieferhistorie.lehre_html | safe }}</div>
      {% endif %}
    </div>
  </details>
</div>

<!-- 8 RADAR -->
<div class="card">
  <h2>Radar</h2>
  {% for r in d.radar %}
  <div class="radar"><div class="pfeil {{ r.farbe|default('tn') }}">{{ r.pfeil }}</div>
    <div class="txt">{{ r.text_html | safe }}</div>
    <div class="horizont">{{ r.horizont }}</div></div>
  {% endfor %}
</div>

<!-- 9 LIMIT -->
<div class="card">
  <h2>Limit und Kanal</h2>
  <div class="limitbox">
    <div style="font-size:11px;text-transform:uppercase;letter-spacing:.07em;
      color:var(--tx3)">{{ d.limit.titel }}</div>
    <div class="z mono">{{ d.limit.wert }} <small>{{ d.limit.einheit }}</small></div>
    <div class="d">{{ d.limit.beschreibung_html | safe }}</div>
  </div>
  {% if d.limit.info_html %}
  <div class="info">{{ d.limit.info_html | safe }}</div>
  {% endif %}
  {% if d.limit.details %}
  <details class="expand"><summary>Zielfenster, Kanal &amp; weitere Details</summary>
    <ul class="fakten" style="margin-top:6px">
      {% for det in d.limit.details %}<li>{{ det | safe }}</li>{% endfor %}
    </ul>
  </details>
  {% endif %}
</div>

<!-- FUSS -->
<div class="fuss">
  <div>
    <h4>{{ d.fuss.quellen_titel }}</h4>
    {% for q in d.fuss.quellen %}<p><b>{{ q.label }}:</b> {{ q.text }}</p>{% endfor %}
  </div>
  <div>
    <h4>{{ d.fuss.nicht_ermittelbar_titel|default("Nicht ermittelbar") }}</h4>
    {% for q in d.fuss.nicht_ermittelbar %}<p><b>{{ q.label }}:</b> {{ q.text }}</p>{% endfor %}
  </div>
</div>

</div>
</body>
</html>
